# Copy to .env before `docker compose up` if you want to change anything.

# Host port for the browser UI.
PAUSELETTE_PORT=8000

# 1 starts the browser UI with `docker compose up`; 0 starts nothing, for a
# command-line-only setup (`docker compose run --rm cli …`). The CLI is a
# one-shot command, not a service, so there is nothing else to switch off.
PAUSELETTE_UI=1

# Files the CLI writes belong to this uid/gid.
PAUSELETTE_UID=1000
PAUSELETTE_GID=1000
