# Example PausePalette settings.
#
# Copy this file to ".env" next to compose.yaml and edit it for your own
# instance. Docker Compose loads ".env" automatically; it is the only file
# read, so this example is safe to keep in the repo.

# The public address your instance is served at, if any (optional).
# It is what the pages advertise in link previews and in their canonical
# link. Leave it blank when you only reach the app over localhost or the LAN.
PAUSEPALETTE_PUBLIC_URL=

# The user id and group id that own the job files written to ./data.
# Set these to your own (see `id -u` and `id -g`) so the files are yours.
PAUSEPALETTE_UID=1000
PAUSEPALETTE_GID=1000
